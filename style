:root{--bg:#0b0b0b;--card:#151515;--line:#262626;--y:#ffd600;--t:#f4f1ea;--m:#9a9a9a;--w:1200px}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{background:var(--bg);color:var(--t);font:400 16px/1.5 Manrope,system-ui,sans-serif}
h1,h2,h3,.logo,.btn,.big{font-family:Unbounded,Arial Black,sans-serif;text-transform:uppercase}
a{color:inherit;text-decoration:none}
:focus-visible{outline:3px solid var(--y);outline-offset:3px}
html[data-l=ru] .uz,html[data-l=uz] .ru{display:none}
.wrap{max-width:var(--w);margin:0 auto;padding:0 24px}
header{position:fixed;inset:0 0 auto;z-index:20;background:rgba(11,11,11,.85);backdrop-filter:blur(10px);border-bottom:1px solid #151515}
header .wrap{display:flex;align-items:center;justify-content:space-between;height:68px;gap:16px}
.logo{display:flex;gap:12px;align-items:center;font-size:15px;font-weight:800;line-height:1}
.logo i{width:40px;height:40px;border-radius:10px;background:var(--y);display:grid;place-items:center}
.logo b{color:var(--y);display:block;margin-top:3px}
nav{display:flex;gap:32px;font-size:14px}nav a:hover{color:var(--y)}
.r{display:flex;gap:16px;align-items:center}
.lang{display:flex;border:1px solid var(--line);border-radius:99px;padding:3px;font-size:12px;font-weight:600}
.lang button{border:0;background:none;color:var(--t);padding:5px 12px;border-radius:99px;cursor:pointer;font:inherit}
html[data-l=ru] .lang [data-s=ru],html[data-l=uz] .lang [data-s=uz]{background:var(--y);color:#0b0b0b}
.btn{display:inline-flex;gap:10px;align-items:center;background:var(--y);color:#0b0b0b;font-weight:800;font-size:14px;padding:14px 22px;border-radius:99px}
.btn:hover{filter:brightness(1.08)}
.btn svg{width:18px;height:18px}
.hero{min-height:100vh;display:flex;flex-direction:column;justify-content:flex-end;padding:120px 0 40px;position:relative;overflow:hidden}
.ghost{position:absolute;right:-20px;top:100px;font:900 clamp(80px,14vw,190px)/1 Unbounded,sans-serif;color:transparent;-webkit-text-stroke:1.5px #333;pointer-events:none}
.pill{display:inline-flex;gap:10px;align-items:center;border:1px solid #4a3f00;background:#1a1600;color:var(--y);border-radius:99px;padding:8px 16px;font:800 12px Unbounded,sans-serif;letter-spacing:.1em;margin-bottom:28px}
.pill:before{content:"";width:9px;height:9px;border-radius:50%;background:var(--y);box-shadow:0 0 0 4px #4a3f00}
h1{font-size:clamp(52px,10.5vw,140px);font-weight:900;line-height:.92;letter-spacing:-.02em}
h1 span{color:var(--y);display:block}
.sub{margin:36px 0;color:var(--m);letter-spacing:.25em;text-transform:uppercase;font-size:clamp(14px,1.6vw,19px)}
.cta{display:flex;gap:24px;align-items:center;flex-wrap:wrap}
.cta .btn{padding:22px 32px;font-size:15px}
.ph{font:800 22px Unbounded,sans-serif;color:var(--y)}.ph small{display:block;font:400 14px Manrope,sans-serif;color:var(--m)}
.slogan{display:flex;justify-content:space-between;border-top:1px solid var(--line);margin-top:48px;padding-top:24px;color:var(--m);font-style:italic}
.tape{background:var(--y);color:#0b0b0b;transform:rotate(-2deg);margin:40px -20px 0;overflow:hidden;white-space:nowrap;padding:20px 0}
.tape div{display:inline-block;animation:go 30s linear infinite;font:800 22px Unbounded,sans-serif;text-transform:uppercase}
.tape span{margin:0 28px}
@keyframes go{to{transform:translateX(-50%)}}
section{padding:100px 0}
.eyebrow{color:var(--y);font:800 12px Unbounded,sans-serif;letter-spacing:.2em;margin-bottom:16px;text-transform:uppercase}
h2{font-size:clamp(30px,4.4vw,52px);font-weight:800;line-height:1.05;max-width:760px}
.grid{display:grid;grid-template-columns:repeat(6,1fr);gap:20px;margin-top:56px}
.card{grid-column:span 2;position:relative;min-height:300px;border:1px solid var(--line);border-radius:20px;padding:28px;display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden;background:linear-gradient(160deg,#1c1c22,#0e0e10)}
.card:nth-child(1){grid-column:span 4;background:linear-gradient(160deg,#2a2a2e,#0e0e10)}
.card:nth-child(2){grid-column:span 2}
.card:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 80% 0,rgba(255,214,0,.13),transparent 55%)}
.card>*{position:relative}
.card>.art{position:absolute;inset:0;width:100%;height:68%;opacity:.55}.card:after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(11,11,11,.1) 0,rgba(11,11,11,.55) 45%,#0b0b0b 100%)}.card>*:not(.art){z-index:2}.card>.n{z-index:2}
.ico{width:44px;height:44px;border-radius:12px;background:var(--y);display:grid;place-items:center;margin-bottom:16px}
.ico svg{width:22px;height:22px}
.card h3{font-size:20px;font-weight:800;text-transform:none;margin-bottom:8px}
.card p{color:var(--m);font-size:14px;max-width:420px}
.n{position:absolute!important;right:24px;top:18px;font:900 40px Unbounded,sans-serif;color:transparent;-webkit-text-stroke:1px #555}
.guar{background:linear-gradient(120deg,#141414 60%,#2b2400)}
.big{font-size:clamp(40px,8vw,104px);font-weight:900;line-height:.95;color:var(--y)}
.big.o{color:transparent;-webkit-text-stroke:1.5px #555}
.feat{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:56px}
.feat div{border:1px solid var(--line);border-radius:16px;background:#101010;padding:28px;font-weight:600}
.feat b{display:block;color:var(--y);font:800 13px Unbounded,sans-serif;margin-bottom:8px}
.contacts{text-align:center}
.contacts h2{margin:0 auto}
.num{display:block;font:900 clamp(32px,6.5vw,80px)/1 Unbounded,sans-serif;color:var(--y);margin:48px 0}
.info{display:flex;gap:20px;justify-content:center;flex-wrap:wrap;margin-bottom:48px}
.info div{text-align:left;border:1px solid var(--line);border-radius:16px;background:#101010;padding:22px 26px;min-width:320px}
.info small{display:block;color:var(--m);letter-spacing:.15em;font-size:11px;text-transform:uppercase}
.info b{font-size:17px}
footer{border-top:1px solid var(--line);padding:28px 0;color:var(--m);font-size:13px;text-align:center}
@media(max-width:860px){nav{display:none}.card,.card:nth-child(n){grid-column:span 6}.feat{grid-template-columns:1fr}.ghost{top:80px}.slogan{flex-direction:column;gap:8px}header .btn span{display:none}}
@media(prefers-reduced-motion:reduce){.tape div{animation:none}html{scroll-behavior:auto}}

.page{padding:130px 0 80px}.page h1{font-size:clamp(30px,5.5vw,60px);margin-bottom:24px;line-height:1.05}
.page h2{font-size:clamp(22px,3vw,30px);margin:48px 0 16px}.page p,.page li{color:#cfcfcf;max-width:780px;margin-bottom:12px}
.page ul{padding-left:22px}details{border:1px solid var(--line);border-radius:12px;padding:16px 20px;margin:10px 0;max-width:780px;background:#101010}
summary{cursor:pointer;font-weight:600}details p{margin:12px 0 0}.links{display:flex;gap:12px;flex-wrap:wrap;margin-top:16px}
.links a{border:1px solid var(--line);border-radius:99px;padding:10px 18px}.links a:hover{border-color:var(--y);color:var(--y)}
.crumbs{font-size:13px;color:var(--m);margin-bottom:16px}.crumbs a{color:var(--y)}.seo h2{max-width:none}
